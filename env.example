# Kopyalayın: cp env.example .env

PORT=3001

# Postgres bağlantısı. Supabase için: Connect → Session pooler (5432) adresi + DATABASE_SSL=1
DATABASE_URL=postgres://kullanici:sifre@localhost:5432/alliance
DATABASE_SSL=0

# En az 16 karakter, rastgele (ör. `openssl rand -hex 32`)
JWT_SECRET=degistir-bunu-uzun-ve-rastgele-yap
# JWT_TTL=7d

# Frontend adres(ler)i, virgülle
ALLOWED_ORIGINS=http://localhost:5173

# İlk açılışta bu e-postayla kullanıcı yoksa admin hesabı açılır (var olana dokunmaz)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Divizyon Admin
